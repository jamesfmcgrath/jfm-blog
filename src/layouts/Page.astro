---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
	</head>
	<body>
		<Header />
		<main id="main" tabindex="-1">
			<article class="page">
				<h1>{title}</h1>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		padding: 0 8vw 0 10vw;
	}
	.page {
		padding-top: 64px;
		padding-bottom: 72px;
	}
	h1 {
		font-size: 36px;
	}
	.prose {
		font-size: 18px;
		line-height: 1.75;
		max-width: 65ch;
	}
</style>
