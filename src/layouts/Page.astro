---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
	</head>
	<body>
		<Header />
		<main id="main">
			<article class="page">
				<h1>{title}</h1>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	.page {
		max-width: 640px;
		padding: 64px 8vw 72px 10vw;
		margin: 0 auto;
	}
	.prose {
		font-size: 18px;
		line-height: 1.75;
	}
</style>
