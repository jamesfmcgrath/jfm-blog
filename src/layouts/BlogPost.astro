---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	date: Date;
	readingTime: number;
	image?: ImageMetadata;
	prevPost?: { slug: string; title: string };
	nextPost?: { slug: string; title: string };
}

const { title, description, date, readingTime, image, prevPost, nextPost } = Astro.props;
---
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main id="main" tabindex="-1">
			<article class="post">
				<a href="/" class="back">&larr; Home</a>
				<h1>{title}</h1>
				<p class="meta"><FormattedDate date={date} /> &middot; {readingTime} min read</p>
				{image && (
					<Image
						class="hero"
						src={image}
						alt=""
						widths={[640, 1280]}
						sizes="(max-width: 899px) 92vw, 82vw"
					/>
				)}
				<div class="prose">
					<slot />
				</div>
				<nav aria-label="Post navigation" class="post-nav">
					{prevPost && <a href={`/${prevPost.slug}/`}>&larr; {prevPost.title}</a>}
					{nextPost && <a href={`/${nextPost.slug}/`} class="next">{nextPost.title} &rarr;</a>}
				</nav>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		padding: 0 8vw 0 10vw;
	}
	.post {
		padding-top: 64px;
		padding-bottom: 72px;
	}
	.back, .meta {
		font-family: var(--font-zen-kaku);
		font-size: 14px;
		color: var(--muted);
	}
	h1 {
		font-size: 36px;
		margin: 28px 0 14px 0;
	}
	.meta {
		margin: 0 0 48px 0;
	}
	.hero {
		display: block;
		width: 100%;
		max-width: 1280px;
		height: auto;
		border-radius: 2px;
		margin: 0 0 48px 0;
	}
	.prose {
		font-size: 18px;
		line-height: 1.75;
		max-width: 65ch;
	}
	.prose :global(h2) {
		font-family: var(--font-zen-kaku);
		font-weight: 500;
		font-size: 23px;
		margin: 44px 0 18px 0;
	}
	.prose :global(p) {
		margin: 0 0 26px 0;
	}
	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding-top: 40px;
		margin-top: 40px;
		border-top: 1px solid var(--border);
		font-family: var(--font-zen-kaku);
		font-size: 15px;
	}
	.post-nav a {
		max-width: 45%;
	}
	.post-nav .next {
		text-align: right;
	}
</style>
