---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	date: Date;
	readingTime: number;
	prevPost?: { slug: string; title: string };
	nextPost?: { slug: string; title: string };
}

const { title, date, readingTime, prevPost, nextPost } = Astro.props;
---
<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
	</head>
	<body>
		<Header />
		<main id="main" tabindex="-1">
			<article class="post">
				<a href="/" class="back">&larr; Home</a>
				<h1>{title}</h1>
				<p class="meta"><FormattedDate date={date} /> &middot; {readingTime} min read</p>
				<div class="prose">
					<slot />
				</div>
				<nav aria-label="Post navigation" class="post-nav">
					{prevPost && <a href={`/${prevPost.slug}/`}>&larr; {prevPost.title}</a>}
					{nextPost && <a href={`/${nextPost.slug}/`} class="next">{nextPost.title} &rarr;</a>}
				</nav>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	.post {
		max-width: 640px;
		padding: 64px 8vw 72px 10vw;
		margin: 0 auto;
	}
	.back, .meta {
		font-family: var(--font-zen-kaku);
		font-size: 14px;
		color: var(--muted);
	}
	h1 {
		font-size: 36px;
		margin: 28px 0 14px 0;
	}
	.prose {
		font-size: 18px;
		line-height: 1.75;
	}
	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding-top: 40px;
		margin-top: 40px;
		border-top: 1px solid var(--border);
		font-family: var(--font-zen-kaku);
		font-size: 15px;
	}
	.post-nav .next {
		text-align: right;
	}
</style>
