---
import { getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	date: Date;
	readingTime: number;
	image?: ImageMetadata;
	prevPost?: { slug: string; title: string };
	nextPost?: { slug: string; title: string };
}

const { title, description, date, readingTime, image, prevPost, nextPost } = Astro.props;

// Keep frontmatter images for social previews; do not render them in the post body.
const ogImage = image
	? await getImage({ src: image, width: 1200, format: 'jpg' })
	: undefined;
---
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage?.src} />
	</head>
	<body>
		<Header />
		<main id="main" role="main" tabindex="-1">
			<article class="post">
				<a href="/" class="back">&larr; Home</a>
				<h1>{title}</h1>
				<p class="meta"><FormattedDate date={date} /> &middot; {readingTime} min read</p>
				<div class="prose">
					<slot />
				</div>
				<nav aria-label="Post navigation" class="post-nav">
					{prevPost && <a href={`/${prevPost.slug}/`}>&larr; {prevPost.title}</a>}
					{nextPost && <a href={`/${nextPost.slug}/`} class="next">{nextPost.title} &rarr;</a>}
				</nav>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		padding: 0 8vw 0 10vw;
	}
	.post {
		padding-top: 4rem;
		padding-bottom: 4.5rem;
	}
	.back, .meta {
		font-family: var(--font-zen-kaku);
		font-size: 0.875rem;
		color: var(--muted);
	}
	h1 {
		font-size: 2.25rem;
		margin: 1.75rem 0 0.875rem 0;
	}
	.meta {
		margin: 0 0 3rem 0;
	}
	.prose {
		font-size: 1.125rem;
		line-height: 1.75;
		max-width: 65ch;
	}
	.prose :global(h2) {
		font-family: var(--font-zen-kaku);
		font-weight: 500;
		font-size: 1.4375rem;
		margin: 2.75rem 0 1.125rem 0;
	}
	.prose :global(p) {
		margin: 0 0 1.625rem 0;
	}
	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 1.25rem;
		padding-top: 2.5rem;
		margin-top: 2.5rem;
		border-top: 1px solid var(--border);
		font-family: var(--font-zen-kaku);
		font-size: 0.9375rem;
	}
	.post-nav a {
		max-width: 45%;
	}
	.post-nav .next {
		text-align: right;
		justify-content: flex-end;
	}
</style>
