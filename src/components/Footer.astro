---
const year = new Date().getFullYear();

const links = [
	{
		href: 'https://github.com/jamesfmcgrath',
		label: 'GitHub',
		external: true,
		// Simple Icons–style GitHub mark
		path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
		viewBox: '0 0 24 24',
	},
	{
		href: 'https://www.linkedin.com/in/james-mcgrath-web-development/',
		label: 'LinkedIn',
		external: true,
		path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
		viewBox: '0 0 24 24',
	},
	{
		href: 'https://bsky.app/profile/jamesmcgrath.bsky.social',
		label: 'Bluesky',
		external: true,
		// Official Bluesky butterfly mark
		path: 'M123.121 33.854c65.12 48.885 135.16 147.99 160.879 200.972 25.719-52.982 95.759-152.087 160.879-200.972C513.588-17.787 568-36.341 568 51.787c0 17.601-10.09 148.174-16.026 170.087-20.5 73.075-95.005 91.701-161.177 80.43 116.043 19.756 145.466 85.057 81.466 150.358C350.333 576.647 297.667 416.98 284 375.314c-13.667 41.666-66.333 201.333-188.333 77.333-64-65.301-34.577-130.602 81.466-150.358-66.172 11.271-140.677-7.355-161.177-80.43C10.09 199.961 0 69.388 0 51.787 0-36.341 54.412-17.787 123.121 33.854z',
		viewBox: '0 0 568 501',
	},
	{
		href: '/rss.xml',
		label: 'RSS feed',
		external: false,
		path: 'M6.18 15.64A2.18 2.18 0 0 1 8.36 17.82C8.36 19.005 7.38 20 6.18 20S4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z',
		viewBox: '0 0 24 24',
	},
] as const;
---
<footer role="contentinfo">
	<span>&copy; {year} James F. McGrath</span>
	<nav class="links" aria-label="Social and feeds">
		{
			links.map((link) => (
				<a
					href={link.href}
					aria-label={link.label}
					{...(link.external
						? { target: '_blank', rel: 'noopener noreferrer' }
						: {})}
				>
					<svg
						aria-hidden="true"
						focusable="false"
						viewBox={link.viewBox}
						width="18"
						height="18"
						fill="currentColor"
					>
						<path d={link.path} />
					</svg>
				</a>
			))
		}
	</nav>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem 8vw 2.5rem 10vw;
		margin-top: 1.5rem;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		font-family: var(--font-zen-kaku);
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: 0.35rem;
		align-items: center;
	}
	.links a {
		color: var(--muted);
		justify-content: center;
		border-radius: 2px;
	}
	.links a:hover,
	.links a:focus-visible {
		color: var(--accent);
	}
	.links svg {
		display: block;
		flex-shrink: 0;
	}
</style>
