---
const year = new Date().getFullYear();
---
<footer role="contentinfo">
	<span>&copy; {year} James F. McGrath</span>
	<nav class="links" aria-label="Footer">
		<a href="https://github.com/jamesfmcgrath">GitHub</a>
		<a href="mailto:hello@jamesfmcgrath.org">Email</a>
		<a href="/rss.xml">RSS</a>
	</nav>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem 8vw 2.5rem 10vw;
		margin-top: 1.5rem;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		font-family: var(--font-zen-kaku);
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: 1.25rem;
		align-items: center;
	}
	.links a {
		color: var(--muted);
	}
</style>
