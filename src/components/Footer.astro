---
const year = new Date().getFullYear();
---
<footer>
	<span>&copy; {year} James F. McGrath</span>
	<div class="links">
		<a href="https://github.com/jamesfmcgrath">GitHub</a>
		<a href="mailto:hello@jamesfmcgrath.org">Email</a>
		<a href="/rss.xml">RSS</a>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 32px 8vw 40px 10vw;
		margin-top: 24px;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		font-family: var(--font-zen-kaku);
		font-size: 13px;
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: 20px;
	}
	.links a {
		color: var(--muted);
	}
</style>
