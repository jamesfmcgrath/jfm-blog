---
import { getCollection, getEntry, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import Page from '../layouts/Page.astro';
import { deriveExcerpt } from '../lib/excerpt.ts';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
	);
	const pages = await getCollection('pages');

	const postPaths = posts.map((post, index) => ({
		params: { slug: post.data.slug },
		props: {
			kind: 'post',
			entry: post,
			prevPost: index > 0 ? posts[index - 1] : undefined,
			nextPost: index < posts.length - 1 ? posts[index + 1] : undefined,
		},
	}));

	const pagePaths = pages.map((page) => ({
		params: { slug: page.id },
		props: { kind: 'page', entry: page },
	}));

	return [...postPaths, ...pagePaths];
}

const { kind, entry, prevPost, nextPost } = Astro.props;
const { Content } = await render(entry);
---
{kind === 'post' ? (
	<BlogPost
		title={entry.data.title}
		description={entry.data.excerpt ?? deriveExcerpt(entry.body ?? '')}
		image={entry.data.image}
		date={entry.data.date}
		readingTime={Math.max(1, Math.round((entry.body?.split(/\s+/).length ?? 0) / 200))}
		prevPost={prevPost && { slug: prevPost.data.slug, title: prevPost.data.title }}
		nextPost={nextPost && { slug: nextPost.data.slug, title: nextPost.data.title }}
	>
		<Content />
	</BlogPost>
) : (
	<Page title={entry.data.title}>
		<Content />
	</Page>
)}
