---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<html lang="en">
	<head>
		<BaseHead title={`Archive — ${SITE_TITLE}`} description={`${posts.length} posts, newest first.`} />
	</head>
	<body>
		<Header />
		<main id="main" tabindex="-1">
			<h1>Archive</h1>
			<p class="count">{posts.length} posts, newest first.</p>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/${post.data.slug}/`}>{post.data.title}</a>
						<FormattedDate date={post.data.date} />
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		padding: 64px 8vw 80px 10vw;
		max-width: 640px;
	}
	.count {
		font-family: var(--font-zen-kaku);
		font-size: 14px;
		color: var(--muted);
		margin: 0 0 48px 0;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 20px;
		padding: 16px 0;
		border-top: 1px solid var(--border);
	}
	li time {
		font-family: var(--font-zen-kaku);
		font-size: 13px;
		color: var(--muted);
		white-space: nowrap;
	}
</style>
