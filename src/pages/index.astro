---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { deriveExcerpt } from '../lib/excerpt.ts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/james-and-a-monkey.png';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 4);
---
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main" role="main" tabindex="-1">
			<h1 class="sr-only">{SITE_TITLE}</h1>
			<div class="home-hero">
				<Image
					src={heroImage}
					alt="James with a monkey"
					widths={[720, 1200, 1920]}
					sizes="calc(100vw - 18vw)"
					priority
				/>
			</div>
			<section class="intro">
				<p>{SITE_DESCRIPTION}</p>
			</section>
			<section aria-label="Recent posts" class="posts">
				{posts.map((post) => (
					<article class="post-preview">
						<h2><a href={`/${post.data.slug}/`}>{post.data.title}</a></h2>
						<p class="meta"><FormattedDate date={post.data.date} /></p>
						<p class="excerpt">{post.data.excerpt ?? deriveExcerpt(post.body ?? '')}</p>
					</article>
				))}
				<a href="/blog/" class="view-all">View all posts &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.home-hero {
		width: 100%;
		padding-top: 4rem;
		line-height: 0;
	}
	.home-hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	main {
		padding: 0 8vw 0 10vw;
	}
	.intro {
		padding-top: 2rem;
	}
	.intro p {
		font-family: var(--font-zen-kaku);
		font-size: 0.875rem;
		color: var(--muted);
		margin: 0 0 4rem 0;
		letter-spacing: 0.02em;
	}
	.post-preview {
		padding: 2.25rem 0;
		border-top: 1px solid var(--border);
	}
	.post-preview h2 {
		font-size: 1.375rem;
		margin: 0 0 0.625rem 0;
		line-height: 1.35;
	}
	.post-preview .meta {
		font-family: var(--font-zen-kaku);
		font-size: 0.8125rem;
		color: var(--muted);
		margin: 0 0 0.75rem 0;
	}
	.post-preview .excerpt {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--muted);
		max-width: 65ch;
	}
	.view-all {
		display: inline-flex;
		font-family: var(--font-zen-kaku);
		font-size: 0.9375rem;
		color: var(--accent);
		padding: 2rem 0 5rem 0;
		border-top: 1px solid var(--border);
		width: 100%;
		box-sizing: border-box;
	}
</style>
